deepml specialized 0.3
module corpus.deepml_specialized.example_01053
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[17,10]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01053 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 253 }
  validate x with [calibrate, C01053, PhysicalBounds]
}
