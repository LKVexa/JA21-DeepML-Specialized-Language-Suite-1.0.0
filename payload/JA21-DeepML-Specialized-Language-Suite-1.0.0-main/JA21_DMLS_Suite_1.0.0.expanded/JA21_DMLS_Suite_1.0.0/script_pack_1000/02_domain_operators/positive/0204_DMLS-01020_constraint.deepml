deepml specialized 0.3
module corpus.deepml_specialized.example_01020
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[1,10]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01020 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 220 }
  validate x with [calibrate, C01020, PhysicalBounds]
}
