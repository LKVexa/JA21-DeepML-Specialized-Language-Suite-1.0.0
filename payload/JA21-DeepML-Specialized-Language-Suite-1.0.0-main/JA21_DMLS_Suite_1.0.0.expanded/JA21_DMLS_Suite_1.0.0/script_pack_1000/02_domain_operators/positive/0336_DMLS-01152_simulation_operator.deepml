deepml specialized 0.3
module corpus.deepml_specialized.example_01152
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[14,10]
  operator step_simulation(x) -> Tensor pure deterministic
  calibration C01152 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 352 }
  validate x with [step_simulation, C01152, PhysicalBounds]
}
