deepml specialized 0.3
module corpus.deepml_specialized.example_01012
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[10,2]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01012 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 212 }
  validate x with [calibrate, C01012, PhysicalBounds]
}
