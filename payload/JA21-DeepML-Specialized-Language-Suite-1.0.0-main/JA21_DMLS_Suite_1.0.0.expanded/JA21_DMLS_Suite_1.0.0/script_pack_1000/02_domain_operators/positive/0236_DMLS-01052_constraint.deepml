deepml specialized 0.3
module corpus.deepml_specialized.example_01052
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[16,9]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01052 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 252 }
  validate x with [calibrate, C01052, PhysicalBounds]
}
