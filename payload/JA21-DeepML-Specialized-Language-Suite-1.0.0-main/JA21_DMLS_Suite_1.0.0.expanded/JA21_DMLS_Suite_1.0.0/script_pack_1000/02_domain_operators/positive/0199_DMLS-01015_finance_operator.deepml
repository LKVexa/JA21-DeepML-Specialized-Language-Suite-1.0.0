deepml specialized 0.3
module corpus.deepml_specialized.example_01015
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[13,5]
  operator value_at_risk(x) -> Tensor pure deterministic
  calibration C01015 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 215 }
  validate x with [value_at_risk, C01015, PhysicalBounds]
}
