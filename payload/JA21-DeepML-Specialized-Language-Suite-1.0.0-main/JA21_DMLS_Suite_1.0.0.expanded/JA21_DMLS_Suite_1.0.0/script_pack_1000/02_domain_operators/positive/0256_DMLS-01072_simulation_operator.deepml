deepml specialized 0.3
module corpus.deepml_specialized.example_01072
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[2,7]
  operator step_simulation(x) -> Tensor pure deterministic
  calibration C01072 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 272 }
