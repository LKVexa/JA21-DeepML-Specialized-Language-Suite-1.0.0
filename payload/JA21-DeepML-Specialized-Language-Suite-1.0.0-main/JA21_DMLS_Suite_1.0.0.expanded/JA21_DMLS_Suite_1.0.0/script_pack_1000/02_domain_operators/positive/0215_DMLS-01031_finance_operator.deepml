deepml specialized 0.3
module corpus.deepml_specialized.example_01031
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[12,10]
  operator value_at_risk(x) -> Tensor pure deterministic
  calibration C01031 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 231 }
  validate x with [value_at_risk, C01031, PhysicalBounds]
}
