deepml specialized 0.3
module corpus.deepml_specialized.example_01165
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[10,12]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01165 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 365 }
  validate x with [calibrate, C01165, PhysicalBounds]
}
