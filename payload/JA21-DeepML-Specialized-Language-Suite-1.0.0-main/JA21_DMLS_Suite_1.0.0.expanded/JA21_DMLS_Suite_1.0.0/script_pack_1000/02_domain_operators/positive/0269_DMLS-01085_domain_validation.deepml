deepml specialized 0.3
module corpus.deepml_specialized.example_01085
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[15,9]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01085 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 285 }
  validate x with [calibrate, C01085, PhysicalBounds]
}
