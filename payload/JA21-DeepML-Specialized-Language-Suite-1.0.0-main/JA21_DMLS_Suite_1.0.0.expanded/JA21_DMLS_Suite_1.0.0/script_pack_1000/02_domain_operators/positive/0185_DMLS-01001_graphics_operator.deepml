deepml specialized 0.3
module corpus.deepml_specialized.example_01001
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[16,2]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01001 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 201 }
  validate x with [project_radiance, C01001, PhysicalBounds]
}
