deepml specialized 0.3
module corpus.deepml_specialized.example_01022
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[3,12]
  operator integrate(x) -> Tensor pure deterministic
  calibration C01022 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 222 }
  validate x with [integrate, C01022, PhysicalBounds]
}
