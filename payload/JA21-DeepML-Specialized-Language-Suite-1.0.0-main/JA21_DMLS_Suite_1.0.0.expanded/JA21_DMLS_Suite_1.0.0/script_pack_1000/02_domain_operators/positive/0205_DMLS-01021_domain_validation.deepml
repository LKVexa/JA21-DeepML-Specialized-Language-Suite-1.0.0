deepml specialized 0.3
module corpus.deepml_specialized.example_01021
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[2,11]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01021 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 221 }
  validate x with [calibrate, C01021, PhysicalBounds]
}
