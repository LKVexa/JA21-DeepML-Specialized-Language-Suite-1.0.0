deepml specialized 0.3
module corpus.deepml_specialized.example_01098
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[11,11]
  operator inverse_dynamics(x) -> Tensor pure deterministic
  calibration C01098 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 298 }
  validate x with [inverse_dynamics, C01098, PhysicalBounds]
}
