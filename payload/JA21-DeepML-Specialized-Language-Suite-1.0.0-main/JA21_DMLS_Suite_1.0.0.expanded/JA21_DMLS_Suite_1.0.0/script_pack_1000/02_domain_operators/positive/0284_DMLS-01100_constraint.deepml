deepml specialized 0.3
module corpus.deepml_specialized.example_01100
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[13,2]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01100 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 300 }
  validate x with [calibrate, C01100, PhysicalBounds]
}
