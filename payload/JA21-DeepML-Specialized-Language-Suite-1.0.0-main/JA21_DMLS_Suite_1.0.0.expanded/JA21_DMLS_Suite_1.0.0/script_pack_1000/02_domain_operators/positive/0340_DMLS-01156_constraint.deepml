deepml specialized 0.3
module corpus.deepml_specialized.example_01156
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[1,3]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01156 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 356 }
  validate x with [calibrate, C01156, PhysicalBounds]
}
