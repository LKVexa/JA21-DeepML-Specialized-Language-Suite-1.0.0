deepml specialized 0.3
module corpus.deepml_specialized.example_01195
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[6,9]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01195 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 395 }
  validate x with [calibrate, C01195, PhysicalBounds]
}
