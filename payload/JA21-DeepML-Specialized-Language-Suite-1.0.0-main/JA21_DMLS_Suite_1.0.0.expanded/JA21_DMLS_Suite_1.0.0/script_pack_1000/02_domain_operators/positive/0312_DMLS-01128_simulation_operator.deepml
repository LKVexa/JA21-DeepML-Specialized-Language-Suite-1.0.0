deepml specialized 0.3
module corpus.deepml_specialized.example_01128
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[7,8]
  operator step_simulation(x) -> Tensor pure deterministic
  calibration C01128 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 328 }
  validate x with [step_simulation, C01128, PhysicalBounds]
}
