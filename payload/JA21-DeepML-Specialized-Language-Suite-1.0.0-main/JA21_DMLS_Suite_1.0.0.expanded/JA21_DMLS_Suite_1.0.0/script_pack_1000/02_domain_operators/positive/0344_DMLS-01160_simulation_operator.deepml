deepml specialized 0.3
module corpus.deepml_specialized.example_01160
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[5,7]
  operator step_simulation(x) -> Tensor pure deterministic
  calibration C01160 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 360 }
  validate x with [step_simulation, C01160, PhysicalBounds]
}
