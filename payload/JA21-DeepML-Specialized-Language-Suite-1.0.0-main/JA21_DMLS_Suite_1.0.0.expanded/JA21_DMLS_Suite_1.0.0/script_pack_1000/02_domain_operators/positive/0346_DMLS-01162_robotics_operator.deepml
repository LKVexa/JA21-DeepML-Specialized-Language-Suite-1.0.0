deepml specialized 0.3
module corpus.deepml_specialized.example_01162
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[7,9]
  operator inverse_dynamics(x) -> Tensor pure deterministic
  calibration C01162 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 362 }
  validate x with [inverse_dynamics, C01162, PhysicalBounds]
}
