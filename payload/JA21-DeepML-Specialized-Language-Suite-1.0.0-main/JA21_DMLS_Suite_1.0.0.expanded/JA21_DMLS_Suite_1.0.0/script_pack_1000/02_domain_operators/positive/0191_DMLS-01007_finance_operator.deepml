deepml specialized 0.3
module corpus.deepml_specialized.example_01007
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[5,8]
  operator value_at_risk(x) -> Tensor pure deterministic
  calibration C01007 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 207 }
  validate x with [value_at_risk, C01007, PhysicalBounds]
}
