deepml specialized 0.3
module corpus.deepml_specialized.example_01180
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[8,5]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01180 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 380 }
  validate x with [calibrate, C01180, PhysicalBounds]
}
