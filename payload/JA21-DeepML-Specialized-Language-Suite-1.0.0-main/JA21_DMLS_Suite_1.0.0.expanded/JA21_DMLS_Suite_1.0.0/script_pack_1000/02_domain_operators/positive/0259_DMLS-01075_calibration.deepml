deepml specialized 0.3
module corpus.deepml_specialized.example_01075
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[5,10]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01075 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 275 }
  validate x with [calibrate, C01075, PhysicalBounds]
}
