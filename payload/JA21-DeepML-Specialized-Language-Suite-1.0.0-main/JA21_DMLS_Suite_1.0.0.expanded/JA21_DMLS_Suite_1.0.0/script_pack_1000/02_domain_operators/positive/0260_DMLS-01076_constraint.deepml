deepml specialized 0.3
module corpus.deepml_specialized.example_01076
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[6,11]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01076 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 276 }
  validate x with [calibrate, C01076, PhysicalBounds]
}
