deepml specialized 0.3
module corpus.deepml_specialized.example_01043
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[7,11]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01043 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 243 }
  validate x with [calibrate, C01043, PhysicalBounds]
}
