deepml specialized 0.3
module corpus.deepml_specialized.example_01153
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[15,11]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01153 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 353 }
  validate x with [project_radiance, C01153, PhysicalBounds]
}
