deepml specialized 0.3
module corpus.deepml_specialized.example_01033
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[14,12]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01033 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 233 }
  validate x with [project_radiance, C01033, PhysicalBounds]
}
