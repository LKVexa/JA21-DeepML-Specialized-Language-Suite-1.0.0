deepml specialized 0.3
module corpus.deepml_specialized.example_01030
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[11,9]
  operator integrate(x) -> Tensor pure deterministic
  calibration C01030 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 230 }
  validate x with [integrate, C01030, PhysicalBounds]
}
