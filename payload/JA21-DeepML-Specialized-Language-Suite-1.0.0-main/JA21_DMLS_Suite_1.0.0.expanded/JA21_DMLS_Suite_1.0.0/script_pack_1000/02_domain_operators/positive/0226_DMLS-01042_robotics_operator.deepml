deepml specialized 0.3
module corpus.deepml_specialized.example_01042
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[6,10]
  operator inverse_dynamics(x) -> Tensor pure deterministic
  calibration C01042 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 242 }
  validate x with [inverse_dynamics, C01042, PhysicalBounds]
}
