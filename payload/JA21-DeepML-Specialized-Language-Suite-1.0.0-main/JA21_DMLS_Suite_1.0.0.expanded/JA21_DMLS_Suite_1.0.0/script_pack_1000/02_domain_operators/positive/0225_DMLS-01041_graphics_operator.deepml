deepml specialized 0.3
module corpus.deepml_specialized.example_01041
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[5,9]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01041 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 241 }
  validate x with [project_radiance, C01041, PhysicalBounds]
}
