deepml specialized 0.3
module corpus.deepml_specialized.example_01065
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[12,11]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01065 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 265 }
  validate x with [project_radiance, C01065, PhysicalBounds]
}
