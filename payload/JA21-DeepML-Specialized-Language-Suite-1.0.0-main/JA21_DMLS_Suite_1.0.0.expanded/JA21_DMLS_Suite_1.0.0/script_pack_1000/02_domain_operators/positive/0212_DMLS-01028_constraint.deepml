deepml specialized 0.3
module corpus.deepml_specialized.example_01028
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[9,7]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01028 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 228 }
