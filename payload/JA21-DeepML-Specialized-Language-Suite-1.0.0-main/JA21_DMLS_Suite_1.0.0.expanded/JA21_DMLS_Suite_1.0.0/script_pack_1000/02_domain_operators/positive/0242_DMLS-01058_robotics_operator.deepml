deepml specialized 0.3
module corpus.deepml_specialized.example_01058
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[5,4]
  operator inverse_dynamics(x) -> Tensor pure deterministic
  calibration C01058 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 258 }
  validate x with [inverse_dynamics, C01058, PhysicalBounds]
}
