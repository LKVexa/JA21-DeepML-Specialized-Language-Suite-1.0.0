deepml specialized 0.3
module corpus.deepml_specialized.example_01008
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[6,9]
  operator step_simulation(x) -> Tensor pure deterministic
  calibration C01008 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 208 }
  validate x with [step_simulation, C01008, PhysicalBounds]
}
