deepml specialized 0.3
module corpus.deepml_specialized.example_01091
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[4,4]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01091 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 291 }
  validate x with [calibrate, C01091, PhysicalBounds]
}
