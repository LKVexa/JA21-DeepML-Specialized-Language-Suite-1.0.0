deepml specialized 0.3
module corpus.deepml_specialized.example_01185
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[13,10]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01185 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 385 }
  validate x with [project_radiance, C01185, PhysicalBounds]
}
