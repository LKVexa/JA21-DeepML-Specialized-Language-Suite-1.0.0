deepml specialized 0.3
module corpus.deepml_specialized.example_01050
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[14,7]
  operator inverse_dynamics(x) -> Tensor pure deterministic
  calibration C01050 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 250 }
  validate x with [inverse_dynamics, C01050, PhysicalBounds]
}
