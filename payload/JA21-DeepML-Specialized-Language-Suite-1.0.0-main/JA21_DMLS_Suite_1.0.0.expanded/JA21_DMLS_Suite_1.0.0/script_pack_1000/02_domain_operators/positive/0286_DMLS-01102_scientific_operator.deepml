deepml specialized 0.3
module corpus.deepml_specialized.example_01102
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[15,4]
  operator integrate(x) -> Tensor pure deterministic
  calibration C01102 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 302 }
  validate x with [integrate, C01102, PhysicalBounds]
}
