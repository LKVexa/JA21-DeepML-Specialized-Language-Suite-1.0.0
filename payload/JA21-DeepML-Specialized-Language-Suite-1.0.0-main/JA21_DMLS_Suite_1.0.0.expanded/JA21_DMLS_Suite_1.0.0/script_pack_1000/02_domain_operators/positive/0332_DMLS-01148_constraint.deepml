deepml specialized 0.3
module corpus.deepml_specialized.example_01148
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[10,6]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01148 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 348 }
  validate x with [calibrate, C01148, PhysicalBounds]
}
