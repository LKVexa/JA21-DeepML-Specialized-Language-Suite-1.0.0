deepml specialized 0.3
module corpus.deepml_specialized.example_01190
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[1,4]
  operator integrate(x) -> Tensor pure deterministic
  calibration C01190 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 390 }
  validate x with [integrate, C01190, PhysicalBounds]
}
