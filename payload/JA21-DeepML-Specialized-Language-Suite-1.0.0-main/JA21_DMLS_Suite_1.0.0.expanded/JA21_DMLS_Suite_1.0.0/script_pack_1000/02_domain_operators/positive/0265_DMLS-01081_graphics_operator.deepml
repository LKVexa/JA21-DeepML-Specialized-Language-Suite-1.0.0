deepml specialized 0.3
module corpus.deepml_specialized.example_01081
policy deterministic
policy no_network
domain finance {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[11,5]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01081 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 281 }
  validate x with [project_radiance, C01081, PhysicalBounds]
}
