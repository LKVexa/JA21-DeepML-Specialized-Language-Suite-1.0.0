deepml specialized 0.3
module corpus.deepml_specialized.example_01155
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[17,2]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01155 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 355 }
  validate x with [calibrate, C01155, PhysicalBounds]
}
