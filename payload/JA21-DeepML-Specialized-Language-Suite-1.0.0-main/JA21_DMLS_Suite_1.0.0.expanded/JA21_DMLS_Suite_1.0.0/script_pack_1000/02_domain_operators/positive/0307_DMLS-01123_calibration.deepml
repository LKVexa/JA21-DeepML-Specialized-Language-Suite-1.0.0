deepml specialized 0.3
module corpus.deepml_specialized.example_01123
policy deterministic
policy no_network
domain graphics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[2,3]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01123 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 323 }
  validate x with [calibrate, C01123, PhysicalBounds]
}
