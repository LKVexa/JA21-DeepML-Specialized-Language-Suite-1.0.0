deepml specialized 0.3
module corpus.deepml_specialized.example_01145
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[7,3]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01145 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 345 }
  validate x with [project_radiance, C01145, PhysicalBounds]
}
