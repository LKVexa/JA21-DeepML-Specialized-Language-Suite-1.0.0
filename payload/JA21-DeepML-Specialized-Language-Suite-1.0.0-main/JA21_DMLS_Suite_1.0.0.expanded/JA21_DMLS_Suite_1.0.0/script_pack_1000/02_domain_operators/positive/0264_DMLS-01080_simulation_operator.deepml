deepml specialized 0.3
module corpus.deepml_specialized.example_01080
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[10,4]
  operator step_simulation(x) -> Tensor pure deterministic
  calibration C01080 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 280 }
  validate x with [step_simulation, C01080, PhysicalBounds]
}
