deepml specialized 0.3
module corpus.deepml_specialized.example_01057
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[4,3]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01057 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 257 }
  validate x with [project_radiance, C01057, PhysicalBounds]
}
