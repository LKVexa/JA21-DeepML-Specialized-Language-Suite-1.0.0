deepml specialized 0.3
module corpus.deepml_specialized.example_01110
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[6,12]
  operator integrate(x) -> Tensor pure deterministic
  calibration C01110 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 310 }
  validate x with [integrate, C01110, PhysicalBounds]
}
