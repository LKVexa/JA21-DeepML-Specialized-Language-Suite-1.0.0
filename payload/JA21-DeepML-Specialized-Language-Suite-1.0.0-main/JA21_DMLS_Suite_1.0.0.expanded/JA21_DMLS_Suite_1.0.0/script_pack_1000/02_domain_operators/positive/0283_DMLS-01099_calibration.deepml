deepml specialized 0.3
module corpus.deepml_specialized.example_01099
policy deterministic
policy no_network
domain biology {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[12,12]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01099 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 299 }
  validate x with [calibrate, C01099, PhysicalBounds]
}
