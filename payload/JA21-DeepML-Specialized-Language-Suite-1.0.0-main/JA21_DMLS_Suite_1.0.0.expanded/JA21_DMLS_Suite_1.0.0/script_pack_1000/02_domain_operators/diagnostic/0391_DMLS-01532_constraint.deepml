deepml specialized 0.3
module corpus.deepml_specialized.example_01532
policy deterministic
policy no_network
domain robotics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[3,5]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01532 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 732 }
  validate x with [calibrate, C01532, PhysicalBounds]
}
assert domain.semantic_hash == "invalid-01532"
