deepml specialized 0.3
module corpus.deepml_specialized.example_01005
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[3,6]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01005 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 205 }
  validate x with [calibrate, C01005, PhysicalBounds]
}
assert domain.semantic_hash == "invalid-01005"
