deepml specialized 0.3
module corpus.deepml_specialized.example_01105
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[1,7]
  operator project_radiance(x) -> Tensor pure deterministic
  calibration C01105 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 305 }
  validate x with [project_radiance, C01105, PhysicalBounds]
}
