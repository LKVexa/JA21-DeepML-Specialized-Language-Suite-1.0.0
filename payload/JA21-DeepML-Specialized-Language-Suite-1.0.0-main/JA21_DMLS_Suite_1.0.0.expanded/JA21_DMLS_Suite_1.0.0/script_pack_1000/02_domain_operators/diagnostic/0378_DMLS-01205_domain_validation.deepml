deepml specialized 0.3
module corpus.deepml_specialized.example_01205
policy deterministic
policy no_network
domain physics {
  unit InputUnit = base("input")
  tensor x: f64<InputUnit>[16,8]
  operator calibrate(x) -> Tensor pure deterministic
  calibration C01205 { method: bounded_least_squares tolerance: 1e-6 }
  constraint PhysicalBounds { min: 0 max: 405 }
  validate x with [calibrate, C01205, PhysicalBounds]
}
assert domain.semantic_hash == "invalid-01205"
