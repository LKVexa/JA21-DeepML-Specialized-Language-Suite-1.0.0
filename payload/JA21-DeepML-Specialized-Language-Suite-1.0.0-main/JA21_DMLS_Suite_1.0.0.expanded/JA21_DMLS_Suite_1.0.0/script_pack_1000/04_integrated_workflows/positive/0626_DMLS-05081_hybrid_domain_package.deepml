deepml specialized 0.3
module corpus.deepml_specialized.example_05081
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05081 {
    science = scientific_pipeline(dataset="local:05081")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=681)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05081 as "hybrid_05081.msslb"
}
