deepml specialized 0.3
module corpus.deepml_specialized.example_05097
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05097 {
    science = scientific_pipeline(dataset="local:05097")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=697)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05097 as "hybrid_05097.msslb"
}
