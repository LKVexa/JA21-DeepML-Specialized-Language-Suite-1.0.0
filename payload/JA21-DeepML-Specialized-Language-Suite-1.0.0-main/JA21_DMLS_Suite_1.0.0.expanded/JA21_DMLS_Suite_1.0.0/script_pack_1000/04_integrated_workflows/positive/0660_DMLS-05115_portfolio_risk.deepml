deepml specialized 0.3
module corpus.deepml_specialized.example_05115
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05115 {
    science = scientific_pipeline(dataset="local:05115")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=715)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05115 as "hybrid_05115.msslb"
}
