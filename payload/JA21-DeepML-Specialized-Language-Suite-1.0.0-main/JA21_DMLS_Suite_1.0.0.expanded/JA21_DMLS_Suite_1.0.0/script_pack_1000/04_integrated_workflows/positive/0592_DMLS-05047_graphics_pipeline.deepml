deepml specialized 0.3
module corpus.deepml_specialized.example_05047
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05047 {
    science = scientific_pipeline(dataset="local:05047")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=647)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05047 as "hybrid_05047.msslb"
}
