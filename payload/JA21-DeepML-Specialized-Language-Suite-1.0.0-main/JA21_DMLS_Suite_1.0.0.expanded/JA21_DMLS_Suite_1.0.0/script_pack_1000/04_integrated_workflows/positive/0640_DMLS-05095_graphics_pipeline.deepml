deepml specialized 0.3
module corpus.deepml_specialized.example_05095
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05095 {
    science = scientific_pipeline(dataset="local:05095")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=695)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05095 as "hybrid_05095.msslb"
}
