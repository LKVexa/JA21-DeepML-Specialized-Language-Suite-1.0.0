deepml specialized 0.3
module corpus.deepml_specialized.example_05129
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05129 {
    science = scientific_pipeline(dataset="local:05129")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=729)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05129 as "hybrid_05129.msslb"
}
