deepml specialized 0.3
module corpus.deepml_specialized.example_05117
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05117 {
    science = scientific_pipeline(dataset="local:05117")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=717)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05117 as "hybrid_05117.msslb"
}
