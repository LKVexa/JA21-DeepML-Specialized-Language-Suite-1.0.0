deepml specialized 0.3
module corpus.deepml_specialized.example_05065
policy deterministic
policy no_network
domain workflow_4 {
  graph DomainGraph05065 {
    science = scientific_pipeline(dataset="local:05065")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=665)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05065 as "hybrid_05065.msslb"
}
