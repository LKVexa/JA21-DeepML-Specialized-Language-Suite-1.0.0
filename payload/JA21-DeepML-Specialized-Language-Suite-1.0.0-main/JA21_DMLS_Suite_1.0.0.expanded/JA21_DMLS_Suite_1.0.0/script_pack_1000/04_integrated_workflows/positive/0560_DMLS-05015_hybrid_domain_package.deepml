deepml specialized 0.3
module corpus.deepml_specialized.example_05015
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05015 {
    science = scientific_pipeline(dataset="local:05015")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=615)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05015 as "hybrid_05015.msslb"
}
