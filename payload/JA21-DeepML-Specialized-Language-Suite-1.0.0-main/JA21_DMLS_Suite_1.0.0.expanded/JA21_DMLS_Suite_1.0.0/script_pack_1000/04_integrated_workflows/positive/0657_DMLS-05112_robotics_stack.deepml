deepml specialized 0.3
module corpus.deepml_specialized.example_05112
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05112 {
    science = scientific_pipeline(dataset="local:05112")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=712)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05112 as "hybrid_05112.msslb"
}
