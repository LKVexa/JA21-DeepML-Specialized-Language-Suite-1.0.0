deepml specialized 0.3
module corpus.deepml_specialized.example_05123
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05123 {
    science = scientific_pipeline(dataset="local:05123")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=723)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05123 as "hybrid_05123.msslb"
}
