deepml specialized 0.3
module corpus.deepml_specialized.example_05031
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05031 {
    science = scientific_pipeline(dataset="local:05031")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=631)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05031 as "hybrid_05031.msslb"
}
