deepml specialized 0.3
module corpus.deepml_specialized.example_05032
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05032 {
    science = scientific_pipeline(dataset="local:05032")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=632)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05032 as "hybrid_05032.msslb"
}
