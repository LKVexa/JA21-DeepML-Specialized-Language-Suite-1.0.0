deepml specialized 0.3
module corpus.deepml_specialized.example_05011
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05011 {
    science = scientific_pipeline(dataset="local:05011")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=611)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05011 as "hybrid_05011.msslb"
}
