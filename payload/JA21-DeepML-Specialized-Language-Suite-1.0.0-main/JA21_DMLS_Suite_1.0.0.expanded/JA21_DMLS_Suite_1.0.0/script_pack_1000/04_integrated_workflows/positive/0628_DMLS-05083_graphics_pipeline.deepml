deepml specialized 0.3
module corpus.deepml_specialized.example_05083
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05083 {
    science = scientific_pipeline(dataset="local:05083")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=683)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05083 as "hybrid_05083.msslb"
}
