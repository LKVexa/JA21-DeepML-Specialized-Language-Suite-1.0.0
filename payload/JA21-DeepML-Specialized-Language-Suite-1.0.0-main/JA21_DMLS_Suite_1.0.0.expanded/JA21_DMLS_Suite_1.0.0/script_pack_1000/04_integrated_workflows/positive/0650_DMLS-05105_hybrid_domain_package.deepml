deepml specialized 0.3
module corpus.deepml_specialized.example_05105
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05105 {
    science = scientific_pipeline(dataset="local:05105")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=705)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05105 as "hybrid_05105.msslb"
}
