deepml specialized 0.3
module corpus.deepml_specialized.example_05013
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05013 {
    science = scientific_pipeline(dataset="local:05013")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=613)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05013 as "hybrid_05013.msslb"
}
