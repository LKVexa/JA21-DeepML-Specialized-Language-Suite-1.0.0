deepml specialized 0.3
module corpus.deepml_specialized.example_05004
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05004 {
    science = scientific_pipeline(dataset="local:05004")
    portfolio = portfolio_risk(science, currency=USD)
