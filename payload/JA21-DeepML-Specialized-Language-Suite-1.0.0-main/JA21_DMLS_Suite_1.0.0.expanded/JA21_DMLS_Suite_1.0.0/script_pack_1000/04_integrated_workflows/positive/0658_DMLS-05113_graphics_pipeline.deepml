deepml specialized 0.3
module corpus.deepml_specialized.example_05113
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05113 {
    science = scientific_pipeline(dataset="local:05113")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=713)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05113 as "hybrid_05113.msslb"
}
