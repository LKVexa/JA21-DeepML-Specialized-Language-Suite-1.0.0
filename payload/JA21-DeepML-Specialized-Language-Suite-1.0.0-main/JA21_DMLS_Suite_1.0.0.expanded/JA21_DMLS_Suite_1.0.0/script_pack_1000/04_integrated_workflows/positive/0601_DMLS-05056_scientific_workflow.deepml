deepml specialized 0.3
module corpus.deepml_specialized.example_05056
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05056 {
    science = scientific_pipeline(dataset="local:05056")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=656)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05056 as "hybrid_05056.msslb"
}
