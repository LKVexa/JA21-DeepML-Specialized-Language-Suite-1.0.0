deepml specialized 0.3
module corpus.deepml_specialized.example_05109
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05109 {
    science = scientific_pipeline(dataset="local:05109")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=709)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05109 as "hybrid_05109.msslb"
}
