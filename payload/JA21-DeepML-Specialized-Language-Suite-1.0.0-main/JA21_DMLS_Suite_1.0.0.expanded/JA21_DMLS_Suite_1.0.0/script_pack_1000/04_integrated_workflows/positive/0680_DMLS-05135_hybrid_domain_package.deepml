deepml specialized 0.3
module corpus.deepml_specialized.example_05135
policy deterministic
policy no_network
domain workflow_4 {
  graph DomainGraph05135 {
    science = scientific_pipeline(dataset="local:05135")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=735)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05135 as "hybrid_05135.msslb"
}
