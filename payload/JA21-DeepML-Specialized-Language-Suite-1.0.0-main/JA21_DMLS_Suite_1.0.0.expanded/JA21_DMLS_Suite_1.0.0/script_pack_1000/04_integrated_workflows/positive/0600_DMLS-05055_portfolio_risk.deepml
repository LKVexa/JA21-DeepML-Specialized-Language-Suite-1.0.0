deepml specialized 0.3
module corpus.deepml_specialized.example_05055
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05055 {
    science = scientific_pipeline(dataset="local:05055")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=655)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05055 as "hybrid_05055.msslb"
}
