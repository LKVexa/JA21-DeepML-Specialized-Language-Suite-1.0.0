deepml specialized 0.3
module corpus.deepml_specialized.example_05087
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05087 {
    science = scientific_pipeline(dataset="local:05087")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=687)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05087 as "hybrid_05087.msslb"
}
