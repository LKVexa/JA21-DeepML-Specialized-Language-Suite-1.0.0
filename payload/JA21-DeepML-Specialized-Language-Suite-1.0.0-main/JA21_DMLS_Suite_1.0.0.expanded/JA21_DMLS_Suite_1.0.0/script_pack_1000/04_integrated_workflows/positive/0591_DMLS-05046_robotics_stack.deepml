deepml specialized 0.3
module corpus.deepml_specialized.example_05046
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05046 {
    science = scientific_pipeline(dataset="local:05046")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=646)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05046 as "hybrid_05046.msslb"
}
