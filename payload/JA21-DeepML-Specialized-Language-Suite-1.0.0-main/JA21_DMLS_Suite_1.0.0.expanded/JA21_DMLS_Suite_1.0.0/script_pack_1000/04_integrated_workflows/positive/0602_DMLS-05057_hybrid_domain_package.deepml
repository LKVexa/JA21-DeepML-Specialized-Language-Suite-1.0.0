deepml specialized 0.3
module corpus.deepml_specialized.example_05057
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05057 {
    science = scientific_pipeline(dataset="local:05057")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=657)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05057 as "hybrid_05057.msslb"
}
