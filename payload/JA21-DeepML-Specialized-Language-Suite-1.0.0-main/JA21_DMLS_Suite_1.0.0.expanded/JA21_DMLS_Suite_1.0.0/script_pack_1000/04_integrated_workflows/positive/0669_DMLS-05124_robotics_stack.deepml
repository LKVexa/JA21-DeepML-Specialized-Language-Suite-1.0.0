deepml specialized 0.3
module corpus.deepml_specialized.example_05124
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05124 {
    science = scientific_pipeline(dataset="local:05124")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=724)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05124 as "hybrid_05124.msslb"
}
