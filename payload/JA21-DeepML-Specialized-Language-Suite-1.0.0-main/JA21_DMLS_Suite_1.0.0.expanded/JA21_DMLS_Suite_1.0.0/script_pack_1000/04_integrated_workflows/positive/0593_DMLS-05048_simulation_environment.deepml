deepml specialized 0.3
module corpus.deepml_specialized.example_05048
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05048 {
    science = scientific_pipeline(dataset="local:05048")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=648)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05048 as "hybrid_05048.msslb"
}
