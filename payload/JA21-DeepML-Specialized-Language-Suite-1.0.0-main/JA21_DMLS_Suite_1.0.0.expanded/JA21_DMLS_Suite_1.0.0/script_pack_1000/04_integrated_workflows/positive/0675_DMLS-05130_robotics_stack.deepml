deepml specialized 0.3
module corpus.deepml_specialized.example_05130
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05130 {
    science = scientific_pipeline(dataset="local:05130")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=730)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05130 as "hybrid_05130.msslb"
}
