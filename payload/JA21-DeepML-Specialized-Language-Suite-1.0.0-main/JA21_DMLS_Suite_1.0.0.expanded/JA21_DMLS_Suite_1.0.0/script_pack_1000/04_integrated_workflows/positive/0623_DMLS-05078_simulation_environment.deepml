deepml specialized 0.3
module corpus.deepml_specialized.example_05078
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05078 {
    science = scientific_pipeline(dataset="local:05078")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=678)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05078 as "hybrid_05078.msslb"
}
