deepml specialized 0.3
module corpus.deepml_specialized.example_05110
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05110 {
    science = scientific_pipeline(dataset="local:05110")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=710)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05110 as "hybrid_05110.msslb"
}
