deepml specialized 0.3
module corpus.deepml_specialized.example_05054
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05054 {
    science = scientific_pipeline(dataset="local:05054")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=654)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05054 as "hybrid_05054.msslb"
}
