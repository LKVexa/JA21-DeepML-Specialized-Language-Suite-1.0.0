deepml specialized 0.3
module corpus.deepml_specialized.example_05101
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05101 {
    science = scientific_pipeline(dataset="local:05101")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=701)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05101 as "hybrid_05101.msslb"
}
