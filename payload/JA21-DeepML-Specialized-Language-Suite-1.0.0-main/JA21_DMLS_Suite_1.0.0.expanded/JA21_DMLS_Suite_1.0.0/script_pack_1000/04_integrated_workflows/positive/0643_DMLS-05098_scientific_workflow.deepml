deepml specialized 0.3
module corpus.deepml_specialized.example_05098
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05098 {
    science = scientific_pipeline(dataset="local:05098")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=698)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05098 as "hybrid_05098.msslb"
}
