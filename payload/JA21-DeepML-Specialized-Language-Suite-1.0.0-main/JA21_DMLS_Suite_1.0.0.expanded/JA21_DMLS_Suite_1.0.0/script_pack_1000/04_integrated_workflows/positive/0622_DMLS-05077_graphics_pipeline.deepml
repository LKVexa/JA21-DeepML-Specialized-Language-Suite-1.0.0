deepml specialized 0.3
module corpus.deepml_specialized.example_05077
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05077 {
    science = scientific_pipeline(dataset="local:05077")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=677)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05077 as "hybrid_05077.msslb"
}
