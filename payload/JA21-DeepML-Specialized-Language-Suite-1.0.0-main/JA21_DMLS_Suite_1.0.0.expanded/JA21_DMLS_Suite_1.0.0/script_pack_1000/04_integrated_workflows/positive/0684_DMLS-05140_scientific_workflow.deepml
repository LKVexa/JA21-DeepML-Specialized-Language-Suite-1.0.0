deepml specialized 0.3
module corpus.deepml_specialized.example_05140
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05140 {
    science = scientific_pipeline(dataset="local:05140")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=740)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05140 as "hybrid_05140.msslb"
}
