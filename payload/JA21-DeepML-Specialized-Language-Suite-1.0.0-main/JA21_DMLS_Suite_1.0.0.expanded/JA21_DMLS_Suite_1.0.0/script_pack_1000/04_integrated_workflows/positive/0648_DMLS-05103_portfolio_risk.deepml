deepml specialized 0.3
module corpus.deepml_specialized.example_05103
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05103 {
    science = scientific_pipeline(dataset="local:05103")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=703)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05103 as "hybrid_05103.msslb"
}
