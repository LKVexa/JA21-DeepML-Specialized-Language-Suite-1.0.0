deepml specialized 0.3
module corpus.deepml_specialized.example_05050
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05050 {
    science = scientific_pipeline(dataset="local:05050")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=650)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05050 as "hybrid_05050.msslb"
}
