deepml specialized 0.3
module corpus.deepml_specialized.example_05014
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05014 {
    science = scientific_pipeline(dataset="local:05014")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=614)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05014 as "hybrid_05014.msslb"
}
