deepml specialized 0.3
module corpus.deepml_specialized.example_05060
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05060 {
    science = scientific_pipeline(dataset="local:05060")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=660)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05060 as "hybrid_05060.msslb"
}
