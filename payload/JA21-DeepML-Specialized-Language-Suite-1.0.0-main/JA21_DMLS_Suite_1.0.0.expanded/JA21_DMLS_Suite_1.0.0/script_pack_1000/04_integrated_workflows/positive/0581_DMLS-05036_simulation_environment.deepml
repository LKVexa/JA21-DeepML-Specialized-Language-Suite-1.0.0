deepml specialized 0.3
module corpus.deepml_specialized.example_05036
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05036 {
    science = scientific_pipeline(dataset="local:05036")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=636)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05036 as "hybrid_05036.msslb"
}
