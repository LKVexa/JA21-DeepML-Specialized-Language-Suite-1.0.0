deepml specialized 0.3
module corpus.deepml_specialized.example_05102
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05102 {
    science = scientific_pipeline(dataset="local:05102")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=702)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05102 as "hybrid_05102.msslb"
}
