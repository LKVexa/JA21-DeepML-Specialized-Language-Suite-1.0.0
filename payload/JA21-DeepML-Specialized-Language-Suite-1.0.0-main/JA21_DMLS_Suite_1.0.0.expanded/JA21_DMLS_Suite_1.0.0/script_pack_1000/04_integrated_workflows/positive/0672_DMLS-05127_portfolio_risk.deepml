deepml specialized 0.3
module corpus.deepml_specialized.example_05127
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05127 {
    science = scientific_pipeline(dataset="local:05127")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=727)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05127 as "hybrid_05127.msslb"
}
