deepml specialized 0.3
module corpus.deepml_specialized.example_05070
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05070 {
    science = scientific_pipeline(dataset="local:05070")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=670)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05070 as "hybrid_05070.msslb"
}
