deepml specialized 0.3
module corpus.deepml_specialized.example_05049
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05049 {
    science = scientific_pipeline(dataset="local:05049")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=649)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05049 as "hybrid_05049.msslb"
}
