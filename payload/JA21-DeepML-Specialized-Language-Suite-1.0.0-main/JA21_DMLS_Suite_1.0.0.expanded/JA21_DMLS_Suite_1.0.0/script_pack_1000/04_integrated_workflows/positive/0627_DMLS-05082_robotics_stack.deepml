deepml specialized 0.3
module corpus.deepml_specialized.example_05082
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05082 {
    science = scientific_pipeline(dataset="local:05082")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=682)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05082 as "hybrid_05082.msslb"
}
