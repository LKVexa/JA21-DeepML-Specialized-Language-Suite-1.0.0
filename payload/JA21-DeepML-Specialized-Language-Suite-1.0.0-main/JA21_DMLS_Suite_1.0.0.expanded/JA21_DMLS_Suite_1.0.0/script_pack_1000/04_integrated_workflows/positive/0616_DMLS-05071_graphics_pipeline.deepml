deepml specialized 0.3
module corpus.deepml_specialized.example_05071
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05071 {
    science = scientific_pipeline(dataset="local:05071")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=671)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05071 as "hybrid_05071.msslb"
}
