deepml specialized 0.3
module corpus.deepml_specialized.example_05079
policy deterministic
policy no_network
domain workflow_4 {
  graph DomainGraph05079 {
    science = scientific_pipeline(dataset="local:05079")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=679)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05079 as "hybrid_05079.msslb"
}
