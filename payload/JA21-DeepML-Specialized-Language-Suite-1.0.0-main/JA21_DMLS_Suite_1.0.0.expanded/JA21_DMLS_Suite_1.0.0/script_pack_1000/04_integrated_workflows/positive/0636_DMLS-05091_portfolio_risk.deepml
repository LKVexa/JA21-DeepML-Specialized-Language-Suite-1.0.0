deepml specialized 0.3
module corpus.deepml_specialized.example_05091
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05091 {
    science = scientific_pipeline(dataset="local:05091")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=691)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05091 as "hybrid_05091.msslb"
}
