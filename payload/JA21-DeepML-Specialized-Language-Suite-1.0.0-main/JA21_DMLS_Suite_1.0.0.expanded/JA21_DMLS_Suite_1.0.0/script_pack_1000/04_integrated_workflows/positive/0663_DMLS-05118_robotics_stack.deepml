deepml specialized 0.3
module corpus.deepml_specialized.example_05118
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05118 {
    science = scientific_pipeline(dataset="local:05118")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=718)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05118 as "hybrid_05118.msslb"
}
