deepml specialized 0.3
module corpus.deepml_specialized.example_05030
policy deterministic
policy no_network
domain workflow_4 {
  graph DomainGraph05030 {
    science = scientific_pipeline(dataset="local:05030")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=630)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05030 as "hybrid_05030.msslb"
}
