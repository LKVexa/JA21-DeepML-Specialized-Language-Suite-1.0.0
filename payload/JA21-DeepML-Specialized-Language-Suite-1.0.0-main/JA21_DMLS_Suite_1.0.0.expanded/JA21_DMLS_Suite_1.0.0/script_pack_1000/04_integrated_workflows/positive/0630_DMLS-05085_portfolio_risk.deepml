deepml specialized 0.3
module corpus.deepml_specialized.example_05085
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05085 {
    science = scientific_pipeline(dataset="local:05085")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=685)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05085 as "hybrid_05085.msslb"
}
