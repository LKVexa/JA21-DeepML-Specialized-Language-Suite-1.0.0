deepml specialized 0.3
module corpus.deepml_specialized.example_05019
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05019 {
    science = scientific_pipeline(dataset="local:05019")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=619)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05019 as "hybrid_05019.msslb"
}
