deepml specialized 0.3
module corpus.deepml_specialized.example_05137
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05137 {
    science = scientific_pipeline(dataset="local:05137")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=737)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05137 as "hybrid_05137.msslb"
}
