deepml specialized 0.3
module corpus.deepml_specialized.example_05089
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05089 {
    science = scientific_pipeline(dataset="local:05089")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=689)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05089 as "hybrid_05089.msslb"
}
