deepml specialized 0.3
module corpus.deepml_specialized.example_05128
policy deterministic
policy no_network
domain workflow_4 {
  graph DomainGraph05128 {
    science = scientific_pipeline(dataset="local:05128")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=728)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05128 as "hybrid_05128.msslb"
}
