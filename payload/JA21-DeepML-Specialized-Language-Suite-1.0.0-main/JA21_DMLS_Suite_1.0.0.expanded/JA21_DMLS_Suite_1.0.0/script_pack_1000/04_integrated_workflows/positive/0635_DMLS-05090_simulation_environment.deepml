deepml specialized 0.3
module corpus.deepml_specialized.example_05090
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05090 {
    science = scientific_pipeline(dataset="local:05090")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=690)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05090 as "hybrid_05090.msslb"
}
