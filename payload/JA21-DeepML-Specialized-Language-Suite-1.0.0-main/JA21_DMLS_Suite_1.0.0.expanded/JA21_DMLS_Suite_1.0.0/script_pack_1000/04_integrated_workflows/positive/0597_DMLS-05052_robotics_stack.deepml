deepml specialized 0.3
module corpus.deepml_specialized.example_05052
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05052 {
    science = scientific_pipeline(dataset="local:05052")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=652)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05052 as "hybrid_05052.msslb"
}
