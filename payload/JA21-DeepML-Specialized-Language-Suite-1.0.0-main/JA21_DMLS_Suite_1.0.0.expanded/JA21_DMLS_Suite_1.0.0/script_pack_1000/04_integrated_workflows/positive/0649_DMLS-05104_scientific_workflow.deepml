deepml specialized 0.3
module corpus.deepml_specialized.example_05104
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05104 {
    science = scientific_pipeline(dataset="local:05104")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=704)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05104 as "hybrid_05104.msslb"
}
