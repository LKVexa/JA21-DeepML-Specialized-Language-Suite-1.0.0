deepml specialized 0.3
module corpus.deepml_specialized.example_05120
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05120 {
    science = scientific_pipeline(dataset="local:05120")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=720)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05120 as "hybrid_05120.msslb"
}
