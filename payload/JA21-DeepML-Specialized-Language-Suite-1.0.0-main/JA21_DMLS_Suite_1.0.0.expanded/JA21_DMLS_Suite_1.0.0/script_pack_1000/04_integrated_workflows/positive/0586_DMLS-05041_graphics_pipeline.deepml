deepml specialized 0.3
module corpus.deepml_specialized.example_05041
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05041 {
    science = scientific_pipeline(dataset="local:05041")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=641)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05041 as "hybrid_05041.msslb"
}
