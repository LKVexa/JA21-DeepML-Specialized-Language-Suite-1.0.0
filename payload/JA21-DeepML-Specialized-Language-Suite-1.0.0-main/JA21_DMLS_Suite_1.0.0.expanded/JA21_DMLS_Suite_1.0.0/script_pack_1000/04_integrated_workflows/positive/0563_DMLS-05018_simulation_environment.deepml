deepml specialized 0.3
module corpus.deepml_specialized.example_05018
policy deterministic
policy no_network
domain workflow_6 {
  graph DomainGraph05018 {
    science = scientific_pipeline(dataset="local:05018")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=618)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05018 as "hybrid_05018.msslb"
}
