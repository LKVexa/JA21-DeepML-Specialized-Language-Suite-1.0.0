deepml specialized 0.3
module corpus.deepml_specialized.example_05008
policy deterministic
policy no_network
domain workflow_3 {
  graph DomainGraph05008 {
    science = scientific_pipeline(dataset="local:05008")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=608)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05008 as "hybrid_05008.msslb"
}
