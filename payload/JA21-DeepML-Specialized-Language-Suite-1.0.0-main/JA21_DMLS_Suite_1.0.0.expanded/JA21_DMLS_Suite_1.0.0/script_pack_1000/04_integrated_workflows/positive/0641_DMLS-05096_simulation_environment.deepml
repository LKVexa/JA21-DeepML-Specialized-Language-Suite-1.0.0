deepml specialized 0.3
module corpus.deepml_specialized.example_05096
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05096 {
    science = scientific_pipeline(dataset="local:05096")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=696)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05096 as "hybrid_05096.msslb"
}
