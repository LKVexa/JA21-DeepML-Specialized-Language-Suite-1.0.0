deepml specialized 0.3
module corpus.deepml_specialized.example_05145
policy deterministic
policy no_network
domain workflow_0 {
  graph DomainGraph05145 {
    science = scientific_pipeline(dataset="local:05145")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=745)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05145 as "hybrid_05145.msslb"
}
assert domain.semantic_hash == "invalid-05145"
