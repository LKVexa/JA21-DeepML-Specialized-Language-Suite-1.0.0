deepml specialized 0.3
module corpus.deepml_specialized.example_05161
policy deterministic
policy no_network
domain workflow_2 {
  graph DomainGraph05161 {
    science = scientific_pipeline(dataset="local:05161")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=761)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05161 as "hybrid_05161.msslb"
}
assert domain.semantic_hash == "invalid-05161"
