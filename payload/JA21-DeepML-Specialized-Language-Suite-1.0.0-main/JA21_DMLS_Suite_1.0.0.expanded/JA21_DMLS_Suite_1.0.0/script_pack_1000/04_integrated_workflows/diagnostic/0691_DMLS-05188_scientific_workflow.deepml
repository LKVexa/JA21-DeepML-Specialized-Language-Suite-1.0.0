deepml specialized 0.3
module corpus.deepml_specialized.example_05188
policy deterministic
policy no_network
domain workflow_1 {
  graph DomainGraph05188 {
    science = scientific_pipeline(dataset="local:05188")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=788)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05188 as "hybrid_05188.msslb"
}
assert domain.semantic_hash == "invalid-05188"
