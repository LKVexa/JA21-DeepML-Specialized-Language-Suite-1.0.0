deepml specialized 0.3
module corpus.deepml_specialized.example_05234
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05234 {
    science = scientific_pipeline(dataset="local:05234")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=834)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05234 as "hybrid_05234.msslb"
}
assert domain.semantic_hash == "invalid-05234"
