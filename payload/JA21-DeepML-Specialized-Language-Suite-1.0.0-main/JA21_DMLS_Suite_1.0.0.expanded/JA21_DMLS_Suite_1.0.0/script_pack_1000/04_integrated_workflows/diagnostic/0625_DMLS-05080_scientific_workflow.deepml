deepml specialized 0.3
module corpus.deepml_specialized.example_05080
policy deterministic
policy no_network
domain workflow_5 {
  graph DomainGraph05080 {
    science = scientific_pipeline(dataset="local:05080")
    portfolio = portfolio_risk(science, currency=USD)
    simulation = simulation_environment(portfolio, steps=680)
    graphics = graphics_pipeline(simulation)
    robot = robotics_control(graphics, actuation=declaration_only)
  }
  package hybrid DomainGraph05080 as "hybrid_05080.msslb"
}
assert domain.semantic_hash == "invalid-05080"
