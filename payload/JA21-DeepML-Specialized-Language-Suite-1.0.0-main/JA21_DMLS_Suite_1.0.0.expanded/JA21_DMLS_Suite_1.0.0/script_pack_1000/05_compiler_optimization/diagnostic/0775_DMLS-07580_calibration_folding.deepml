deepml specialized 0.3
module corpus.deepml_specialized.example_07580
policy deterministic
policy no_network
domain optimized_0 {
  unit meter = base("length")
  unit second = base("time")
  tensor velocity: f64<meter/second>[16,3]
  graph DomainGraph07580 { a = velocity * 1 b = sparse(a) c = calibrated(b, constant=1.0) }
  optimize DomainGraph07580 using [unit_propagation, dimensional_simplification, op_specialization, sparse_planning, calibration_folding, target_lowering]
